{
  "name": "a11yfix-ai",
  "version": "0.1.0",
  "description": "A11yFix AI — RGAA/WCAG accessibility & performance copilot Chrome extension",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "keywords": [
    "chrome-extension",
    "accessibility",
    "rgaa",
    "wcag",
    "a11y",
    "audit",
    "ai"
  ],
  "license": "MIT",
  "dependencies": {
    "axe-core": "^4.12.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  }
}
